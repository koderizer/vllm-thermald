[Unit]
Description=Thermal manager for the vLLM container
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -u @INSTALL_DIR@/vllm_thermald.py run
Restart=always
RestartSec=2
WatchdogSec=60
# Signal only the daemon on stop, so its final docker and nvidia-smi calls can finish.
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
PrivateTmp=yes
StateDirectory=vllm-thermald
StateDirectoryMode=0700

[Install]
WantedBy=default.target
